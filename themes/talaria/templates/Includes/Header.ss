<header class="site-header" role="banner">
	<div class="site-header__inner">
		<a href="$BaseHref" class="site-brand" rel="home">
			<svg class="site-brand__mark" width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path fill="currentColor" d="M 7.50 23.50 Q 14.50 16.73 19.42 4.42 Q 10.51 14.24 7.50 23.50 Z"/>
				<path fill="currentColor" d="M 7.50 23.50 Q 15.62 19.21 23.25 9.31 Q 12.61 15.87 7.50 23.50 Z"/>
				<path fill="currentColor" d="M 7.50 23.50 Q 15.80 21.84 25.03 14.95 Q 13.92 17.98 7.50 23.50 Z"/>
				<path fill="currentColor" d="M 7.50 23.50 Q 14.99 24.00 24.32 19.92 Q 14.14 19.99 7.50 23.50 Z"/>
				<path fill="currentColor" d="M 7.50 23.50 Q 13.52 25.66 21.99 24.01 Q 13.65 21.76 7.50 23.50 Z"/>
				<path fill="currentColor" d="M 7.50 23.50 Q 11.75 26.42 18.66 26.28 Q 12.62 22.92 7.50 23.50 Z"/>
				<circle cx="7.5" cy="23.5" r="2.7" fill="currentColor"/>
				<circle data-hole cx="7.5" cy="23.5" r="1.15"/>
			</svg>
			<span class="site-brand__wordmark">Talaria</span>
		</a>

		<button
			type="button"
			class="site-nav-trigger"
			data-nav-open
			aria-haspopup="dialog"
			aria-controls="site-nav-palette"
			aria-expanded="false"
		>
			<svg class="site-nav-trigger__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M4 6h16M4 12h10M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
			</svg>
			<span class="site-nav-trigger__label">Navigation</span>
			<kbd class="site-nav-trigger__kbd">⌘K</kbd>
		</button>
	</div>
</header>

<% include Navigation %>
