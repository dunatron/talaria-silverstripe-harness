# For a complete list of core environment variables see
# https://docs.silverstripe.org/en/5/getting_started/environment_management/#core-environment-variables

# DB credentials
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="localhost"
SS_DATABASE_USERNAME="<user>"
SS_DATABASE_PASSWORD="<password>"
SS_DATABASE_NAME="<database>"

# WARNING: in a live environment, change this to "live" instead of dev
SS_ENVIRONMENT_TYPE="dev"

# Talaria (from DDEV → host Serverpod API)
TALARIA_DSN="http://host.docker.internal:8080"
# Browser inject only — same-origin HTTPS proxy (see .ddev/apache/apache-site.conf).
# Required when the site is HTTPS; browsers block http://host.docker.internal (mixed content).
TALARIA_BROWSER_DSN="https://new-talaria-ss-test.ddev.site/talaria-api"
TALARIA_API_KEY="tal_live_…"
TALARIA_ENVIRONMENT="development"
TALARIA_RELEASE="local-ss-test"
